#!/usr/bin/env python3
"""synk-monitor: the health monitor of softsynk-server-management (disk, memory, cpu, services, failed units).

Module "monitor". Python 3.11+ standard library plus lib/softsynk. A systemd timer runs `check` every few minutes;
it records history and mails through synk-notify when something needs attention and when it is over. The logic lives
in monitorlib.py (shared with synk-dash); this file is the operator side: setup, check, report, test-alert,
status. See README.md in this folder.
"""
import copy
import json
import os
import re
import sys
from datetime import timedelta

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.join(HERE, "..", "..", "lib"))

import monitorlib as ml  # noqa: E402
from softsynk import core, notify, sysinfo, ui  # noqa: E402

VERSION = "1.0.0"
MODULE = "monitor"
UNITS = ("softsynk-monitor.service", "softsynk-monitor.timer")
KNOWN = ("nginx.service", "apache2.service", "php*-fpm.service", "mysql.service", "mariadb.service", "postgresql@*.service",
         "redis-server*.service", "meilisearch.service", "supervisor.service", "cron.service")  # proposed when running
ENV = ml.Env()  # everything that touches the host; tests replace it


# ---------------------------------------------------------------- status

def _timer_interval():
    try:
        with open(os.path.join(core.unit_dir(), UNITS[1]), encoding="utf-8") as f:
            m = re.search(r"^OnUnitActiveSec=(\d+)s$", f.read(), re.M)
        return int(m[1]) if m else None
    except OSError:
        return None


def build_status(ctx):
    """Status document (schema 1). No config: not installed. Otherwise judged by the last check, plus warnings about
    the monitor itself (mail cannot be sent, timer missing or disagreeing, mail failing)."""
    if not os.path.exists(ctx.config_path):
        return core.status_doc(MODULE, VERSION, "not_installed", "unknown", "monitoring is not set up", actions=["synk-monitor setup"])
    latest = ml.read_state(ctx, "latest.json", None, ENV.run_dir)
    try:
        cfg = ml.load(ctx)
    except core.Fail as f:
        return core.status_doc(MODULE, VERSION, "installed", "unhealthy", "the monitor config is invalid", warnings=[str(f)],
                               actions=["synk-monitor setup"])
    state = ml.read_alerts(ctx, ENV.run_dir)
    warnings = []
    try:
        mail_ok = notify.load(ctx.other("notify")) is not None
    except core.Fail:
        mail_ok = False
    if not mail_ok:
        warnings.append("mail is not configured, so no alert can be sent: run synk-notify configure")
    stuck = [e for e in state["pending"] if e.get("tries")]
    if stuck:
        warnings.append(f"mail is failing: {len(stuck)} message(s) waiting, last error: {stuck[-1].get('error')}")
    if isinstance(latest, dict) and latest.get("history"):
        warnings.append(f"history is not being recorded: {latest['history']}")
    seen = _timer_interval()
    if seen is None:
        warnings.append(f"the timer unit {UNITS[1]} is missing in {core.unit_dir()}: run synk-monitor setup")
    elif seen != cfg["check_interval_sec"]:
        warnings.append(f"the timer runs every {seen} s but the config says {cfg['check_interval_sec']} s: run synk-monitor setup")
    if ENV.run(["systemctl", "is-active", UNITS[1]], timeout=10).out.strip() != "active":
        warnings.append(f"{UNITS[1]} is not active: run synk-monitor setup")
    warnings = [core.redact(w) for w in warnings]
    t = core.parse_iso(latest.get("t")) if isinstance(latest, dict) else None
    if t is None:
        return core.status_doc(MODULE, VERSION, "installed", "unknown", "no check has run yet; the timer runs the first one soon",
                               warnings=warnings, actions=["synk-monitor check"])
    age, level = (core.now() - t).total_seconds(), latest.get("level", 0)
    heads = [ml.headline(k, c["value"]) for k, c in sorted(ml.raised(state).items(), key=lambda kv: (-kv[1]["level"], kv[0]))]
    health = "stale" if age > 3 * cfg["check_interval_sec"] else ("healthy", "degraded", "unhealthy")[level]
    if health == "healthy" and warnings:
        health = "degraded"
    summary = ("; ".join(heads) or "all checks ok") + f"; checked {ml.dur(max(age, 0))} ago"
    if health == "stale":
        summary = f"no check for {ml.dur(age)} (every {cfg['check_interval_sec']} s): " + summary
    details = {"level": level, "checked_at": latest["t"], "interval_sec": cfg["check_interval_sec"], "raised": ml.raised(state),
               "incident": state["incident"], "pending_mail": len(state["pending"])}
    return core.status_doc(MODULE, VERSION, "installed", health, summary, details, warnings, ["synk-dash", "synk-monitor report"])


def safe_status(ctx):
    """The status document, whatever goes wrong: --status-json must always answer."""
    try:
        return build_status(ctx)
    except Exception as e:  # noqa: BLE001
        return core.status_doc(MODULE, VERSION, "unknown", "unknown", core.redact(f"status failed: {type(e).__name__}: {e}"))


# ---------------------------------------------------------------- setup

def _unit_text(ctx, name, interval):
    with open(os.path.join(HERE, "systemd", name + ".in"), encoding="utf-8") as f:
        text = f.read()
    alert = os.path.exists(os.path.join(core.unit_dir(), "softsynk-alert@.service"))  # made by synk-notify configure
    onfail = "OnFailure=softsynk-alert@%n.service" if alert else ""
    return (text.replace("@ROOT@", ctx.root).replace("@BIN@", core.exec_path(ctx, __file__)).replace("@INTERVAL@", str(interval))
            .replace("@ONFAILURE@", onfail))


def _service_names(text):
    return [n if n.endswith(".service") else n + ".service" for n in re.split(r"[,\s]+", text.strip()) if n]


def cmd_setup(ctx, a):
    if not core.ROOT_RE.match(ctx.root) or not core.BIN_RE.match(core.exec_path(ctx, __file__)):
        raise core.Fail("The root and this tool's folder must be absolute paths without spaces or special characters "
                        "(they are written into a systemd unit).", core.USAGE)
    try:
        old = core.read_json(ctx.config_path, {})
    except core.Corrupt:
        old = {}  # setup is what fixes a broken config
    old = old if isinstance(old, dict) else {}
    if a.services is not None:
        services = _service_names(a.services)
    else:
        known = old.get("services") or sysinfo.running_services(KNOWN, ENV.run)
        services = _service_names(ui.ask("SERVICES", "Services that must keep running (comma separated, empty = none)", ", ".join(known)))
    bad = [s for s in services if not ml.SERVICE_RE.match(s)]
    if bad:
        raise core.Fail(f"not a service unit name: {', '.join(bad)}", core.USAGE)
    interval = a.interval if a.interval is not None else old.get("check_interval_sec", ml.DEFAULTS["check_interval_sec"])
    if not isinstance(interval, int) or not 30 <= interval <= 3600:
        raise core.Fail("--interval must be between 30 and 3600 seconds", core.USAGE)
    cfg = {**old, "services": services, "check_interval_sec": interval}
    units = {n: _unit_text(ctx, n, interval) for n in UNITS}
    if a.dry_run:
        ui.info(f"[dry run] would write {ctx.config_path}:")
        print(json.dumps(cfg, indent=2, sort_keys=True))
        ui.info(f"[dry run] would write {', '.join(os.path.join(core.unit_dir(), n) for n in UNITS)}, enable {UNITS[1]} and take a first sample")
        return core.OK
    with core.lock(ctx):
        core.write_if_changed(ctx.config_path, json.dumps(cfg, indent=2, sort_keys=True) + "\n", 0o644)
        core.ensure_dir(core.unit_dir())
        changed = [core.write_if_changed(os.path.join(core.unit_dir(), n), t, 0o644) for n, t in units.items()]
        if any(changed):
            ui.info(f"Wrote the units in {core.unit_dir()}")
            if not ENV.run(["systemctl", "daemon-reload"], timeout=60).ok:
                ui.warn("systemctl daemon-reload failed: run it by hand so that the new units are known")
        if not ENV.run(["systemctl", "enable", "--now", UNITS[1]], timeout=60).ok:
            ui.warn(f"could not enable {UNITS[1]}: run systemctl enable --now {UNITS[1]} by hand")
        ml.check_once(ctx, ENV)  # the first sample, so that status and synk-dash have something to show
    try:
        mail = notify.load(ctx.other("notify")) is not None
    except core.Fail:
        mail = False
    if not mail:
        ui.warn("mail is not configured, so alerts cannot be sent yet: run synk-notify configure")
    core.log(ctx, "monitor.setup", services=services, interval=interval)
    ui.ok(f"Monitoring is on: a check every {interval} s. Look at it with: synk-dash")
    return core.OK


# ---------------------------------------------------------------- check, report, test-alert

def cmd_check(ctx, a):
    try:
        with core.lock(ctx):
            doc = ml.check_once(ctx, ENV)
    except core.Busy:
        return core.OK  # the previous run is still going; the next timer run catches up
    print(f"monitor: {ml.WORD[doc['level']]}, checked {doc['t']}")
    return core.OK


def cmd_report(ctx, a):
    latest = ml.read_state(ctx, "latest.json", None, ENV.run_dir)
    if not isinstance(latest, dict) or not isinstance(latest.get("snap"), dict):
        raise core.Fail("no data yet: run /usr/local/bin/synk-monitor check", core.FAILED)
    state = ml.read_alerts(ctx, ENV.run_dir)
    now, level = core.now(), latest.get("level", 0)
    ev = {"id": "report", "kind": "report", "t": core.iso(now), "level": level, "checks": ml.raised(state),
          "incident": state["incident"], "next": None, "tries": 0, "error": None}
    if a.json:
        print(json.dumps({"level": level, "host": ENV.host, "t": latest["t"], "checks": ev["checks"], "incident": state["incident"],
                          "snap": latest["snap"]}, indent=2, sort_keys=True))
        return core.OK
    recs, _ = ml.read_history(ctx.path("data", "history"), now - timedelta(days=1), now)
    subject, body = ml.render_mail(ev, _cfg(ctx), ENV.host, latest["snap"], ml.history_stats(recs), {"dirs": {}, "procs": {}, "incidents": 0}, now)
    if not a.send:
        print(f"Subject: {subject}\n\n{body}", end="")
        return core.OK
    ok, detail = ENV.send(ctx.root, subject, body)
    (ui.ok if ok else ui.error)(detail)
    return core.OK if ok else core.FAILED


def cmd_test_alert(ctx, a):
    now = core.now()
    t = core.iso(now)
    ev = {"id": "test", "kind": "open", "t": t, "level": 2, "next": None, "tries": 0, "error": None,
          "checks": {"disk:/": {"level": 2, "value": 93.0, "since": t}}, "incident": {"opened": t, "peak": 2, "keys": ["disk:/"]}}
    subject, body = ml.render_mail(ev, _cfg(ctx), ENV.host, None, {}, {"dirs": {}, "procs": {}, "incidents": 0}, now)
    body = f"This is a test from synk-monitor test-alert. Nothing is wrong; the numbers below are made up.\n\n{body}"
    ok, detail = ENV.send(ctx.root, "TEST: " + subject, body)
    (ui.ok if ok else ui.error)(detail)
    return core.OK if ok else core.FAILED


def _cfg(ctx):
    """The config, or the defaults when it is invalid (report and test-alert only need the thresholds for text)."""
    try:
        return ml.load(ctx)
    except core.Fail:
        return copy.deepcopy(ml.DEFAULTS)


# ---------------------------------------------------------------- CLI

def build_parser():
    p = core.Parser(prog="synk-monitor", description="Health monitor: checks, history and mail alerts for this server.",
                    epilog="exit codes: 0 ok, 2 failed (no data, mail not sent), 64 usage or config error, 130 cancelled. --status: "
                           "0 healthy, 1 degraded, 2 unhealthy, 3 unknown, stale or not set up; --status-json always exits 0.")
    core.common_args(p)
    p.add_argument("--status", action="store_true", help="show health (read-only); exits by health")
    p.add_argument("--status-json", action="store_true", help="status JSON for softsynk-server (module contract; always exits 0)")
    p.add_argument("--version", action="store_true")
    sub = p.add_subparsers(dest="cmd", parser_class=core.Parser, metavar="COMMAND")
    s = sub.add_parser("setup", help="choose the watched services, install and start the timer")
    core.common_args(s)
    s.add_argument("--services", help="services that must keep running, comma separated (default: ask, proposing the running ones)")
    s.add_argument("--interval", type=int, help="seconds between checks, 30 to 3600 (default: 300)")
    s = sub.add_parser("check", help="one check (run by the timer)")
    core.common_args(s)
    s = sub.add_parser("report", help="the current state as the mail would show it")
    core.common_args(s)
    s.add_argument("--send", action="store_true", help="mail it instead of printing it")
    s = sub.add_parser("test-alert", help="mail a marked sample alert (changes no state)")
    core.common_args(s)
    return p


COMMANDS = {"setup": cmd_setup, "check": cmd_check, "report": cmd_report, "test-alert": cmd_test_alert}


def main(argv=None):
    p = build_parser()
    a = core.parse_args(p, argv)
    ui.setup(a)
    if a.version:
        print(f"synk-monitor {VERSION}")
        return core.OK
    ctx = core.Ctx(MODULE, a.root)

    def run():
        if a.status_json:
            return core.show_status(safe_status(ctx), True)
        if a.status:
            return core.show_status(safe_status(ctx), a.json, json_exit_zero=False)
        if not a.cmd:
            p.print_help(sys.stderr)
            return core.USAGE
        return COMMANDS[a.cmd](ctx, a)
    return core.main(run, "synk-monitor")


if __name__ == "__main__":
    sys.exit(main())
