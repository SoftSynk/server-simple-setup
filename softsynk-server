#!/usr/bin/env python3
"""softsynk-server: install, configure, update and report on server modules.

Python 3.11+ standard library only. No module-specific code lives here: every
module is described by a data-only manifest (docs/module-development.md).
Exit codes: 0 ok/healthy, 1 degraded, 2 unhealthy or failed, 3 incomplete,
64 invalid request, 130 cancelled.
"""
import argparse
import contextlib
import dataclasses
import datetime
import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import tomllib
import uuid

INTERFACE = 1  # module contract version this engine speaks
SCHEMA = 1  # registry, manifest and status-JSON format version
DEFAULT_ROOT = "/opt/softsynk-server-management"

OK, DEGRADED, FAILED, INCOMPLETE, USAGE, CANCELLED = 0, 1, 2, 3, 64, 130
UNHEALTHY = FAILED

ID_RE = re.compile(r"^[a-z][a-z0-9-]{1,31}$")
VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$")
SHA_RE = re.compile(r"^[0-9a-fA-F]{64}$")
OS_VERSION_RE = re.compile(r"^[0-9]+(\.[0-9]+)*$")
OPS = ("install", "configure", "status", "validate", "update")
REQUIRED_OPS = ("install", "status")
INSTALL_STATES = ("installed", "adopted", "not_installed", "unknown")
HEALTHS = ("healthy", "degraded", "unhealthy", "unknown", "stale", "unsupported")
HEALTH_EXIT = {"healthy": OK, "degraded": DEGRADED, "unhealthy": UNHEALTHY,
               "unknown": INCOMPLETE, "stale": INCOMPLETE}
# Worst-wins ordering of exit codes: a known failure outranks "cannot tell".
SEVERITY = {OK: 0, DEGRADED: 1, INCOMPLETE: 2, UNHEALTHY: 3}
OVERALL_LABEL = {OK: "healthy", DEGRADED: "degraded", UNHEALTHY: "unhealthy",
                 INCOMPLETE: "incomplete"}
COMMANDS = ("install", "configure", "update", "validate")


class Fail(Exception):
    def __init__(self, message, code=FAILED):
        super().__init__(message)
        self.code = code


class Cancelled(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def warn(msg):
    print(f"softsynk-server: {msg}", file=sys.stderr, flush=True)


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- files

def release_dir():
    return os.path.dirname(os.path.realpath(__file__))


def read_version(release):
    try:
        with open(os.path.join(release, "VERSION"), encoding="utf-8") as f:
            return f.read().strip() or "unknown"
    except OSError:
        return "unknown"


def atomic_write(path, text, mode=0o644):
    """Write text so readers see the old or the new file, never a partial one."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise
    dfd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def set_link(root, name, target):
    """Atomically point <root>/<name> at target (new symlink, then rename)."""
    tmp = os.path.join(root, f".{name}.new-{os.getpid()}")
    with contextlib.suppress(FileNotFoundError):
        os.unlink(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, os.path.join(root, name))


@contextlib.contextmanager
def framework_lock(root):
    """Global non-blocking lock for mutating commands; released on exit or crash."""
    path = os.path.join(root, "lock", "framework.lock")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as e:
        raise Fail(f"cannot create lock {path}: {e.strerror} (need root?)")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise Fail(f"another softsynk-server command is running (lock: {path})")
    try:
        yield
    finally:
        os.close(fd)  # closing drops the flock


def record_history(ctx, command, results, code, **extra):
    path = os.path.join(ctx.root, "state", "framework", "history.jsonl")
    entry = {"ts": now_iso(), "run_id": ctx.run_id, "command": command,
             "version": ctx.version, "dry_run": ctx.dry_run, "results": results,
             "exit": code, **extra}
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            with open(path, encoding="utf-8") as f:
                old = f.read()
        except FileNotFoundError:
            old = ""
        atomic_write(path, old + json.dumps(entry, sort_keys=True) + "\n")
    except OSError as e:
        warn(f"could not write history ({e.strerror}); continuing")


# ---------------------------------------------------------------- manifests

@dataclasses.dataclass
class Module:
    id: str
    name: str
    description: str
    version: str
    requires: list
    after: list
    effects: list
    platform: dict
    ops: dict  # op name -> argv with the program as a path inside the release
    commands: dict
    dir: str  # module directory (cwd for its operations)


@dataclasses.dataclass
class Entry:
    id: str
    manifest: str
    module: Module = None  # None when the manifest is invalid
    errors: list = dataclasses.field(default_factory=list)
    unsupported: str = None  # platform mismatch reason (manifest itself is valid)


def resolve_inside(base, rel, release):
    """Return the real path of base/rel, or raise ValueError if it leaves release."""
    if not isinstance(rel, str) or not rel or "\0" in rel:
        raise ValueError("path must be a non-empty string")
    if os.path.isabs(rel):
        raise ValueError(f"absolute path not allowed: {rel}")
    if ".." in rel.split("/"):
        raise ValueError(f"'..' not allowed in path: {rel}")
    real = os.path.realpath(os.path.join(base, rel))
    if os.path.commonpath([real, release]) != release:
        raise ValueError(f"path escapes the release directory (symlink?): {rel}")
    return real


def check_program(rel, mod_dir, release):
    """Validate an argv[0]/command path. Returns an error string or None."""
    try:
        real = resolve_inside(mod_dir, rel, release)
    except ValueError as e:
        return str(e)
    if not os.path.isfile(real):
        return f"file not found: {rel}"
    if not os.access(real, os.X_OK):
        return f"file is not executable: {rel}"
    return None


TOP_KEYS = {"schema", "id", "name", "description", "version", "interface",
            "requires", "after", "effects", "platform", "operations", "commands"}


def parse_manifest(release, entry):
    """Fill entry.module, or entry.errors with every problem found."""
    errs = entry.errors
    try:
        path = resolve_inside(release, entry.manifest, release)
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except (ValueError, OSError, tomllib.TOMLDecodeError) as e:
        errs.append(f"cannot read manifest {entry.manifest}: {e}")
        return
    mod_dir = os.path.dirname(os.path.join(release, entry.manifest))

    for k in sorted(set(data) - TOP_KEYS):
        errs.append(f"unknown field '{k}'")

    def req_str(key):
        v = data.get(key)
        if not isinstance(v, str) or not v.strip():
            errs.append(f"missing or empty required field '{key}' (string)")
            return ""
        return v

    def str_list(key, pattern=None):
        v = data.get(key, [])
        if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
            errs.append(f"'{key}' must be an array of strings")
            return []
        if pattern:
            for x in v:
                if not pattern.match(x):
                    errs.append(f"'{key}' has an invalid module id: {x!r}")
        return v

    schema = data.get("schema")
    if type(schema) is not int or schema != SCHEMA:
        errs.append(f"unsupported or missing manifest schema {schema!r} (expected {SCHEMA})")
    interface = data.get("interface")
    if type(interface) is not int:
        errs.append("missing required field 'interface' (integer)")
    elif interface != INTERFACE:
        errs.append(f"unsupported interface {interface} (this engine supports interface {INTERFACE})")
    if data.get("id") != entry.id:
        errs.append(f"manifest id {data.get('id')!r} does not match registry id {entry.id!r}")
    name, description, version = req_str("name"), req_str("description"), req_str("version")
    if version and not VERSION_RE.match(version):
        errs.append(f"invalid version {version!r}")
    requires = str_list("requires", ID_RE)
    after = str_list("after", ID_RE)
    effects = str_list("effects")

    platform = data.get("platform", {})
    if not isinstance(platform, dict) or set(platform) - {"os", "min_version"}:
        errs.append("[platform] must be a table with only 'os' and 'min_version'")
        platform = {}
    else:
        os_list = platform.get("os", [])
        if not isinstance(os_list, list) or not all(isinstance(x, str) for x in os_list):
            errs.append("platform.os must be an array of strings")
        mv = platform.get("min_version", "")
        if not isinstance(mv, str) or (mv and not OS_VERSION_RE.match(mv)):
            errs.append("platform.min_version must be a string like \"24.04\"")

    ops = {}
    raw = data.get("operations")
    if not isinstance(raw, dict):
        errs.append("[operations] table is required")
        raw = {}
    for k in sorted(set(raw) - set(OPS)):
        errs.append(f"unknown operation '{k}' (known: {', '.join(OPS)})")
    for k in REQUIRED_OPS:
        if k not in raw:
            errs.append(f"operations.{k} is required")
    for k, argv in raw.items():
        if k not in OPS:
            continue
        if isinstance(argv, str):
            errs.append(f"operations.{k} must be an argv array, not a shell string: {argv!r}")
        elif (not isinstance(argv, list) or not argv
              or not all(isinstance(a, str) for a in argv) or not argv[0]):
            errs.append(f"operations.{k} must be a non-empty array of strings")
        else:
            problem = check_program(argv[0], mod_dir, release)
            if problem:
                errs.append(f"operations.{k}: {problem}")
            else:
                ops[k] = [os.path.join(mod_dir, argv[0])] + argv[1:]

    commands = {}
    raw_cmds = data.get("commands", {})
    if not isinstance(raw_cmds, dict):
        errs.append("[commands] must be a table of name = \"path\"")
        raw_cmds = {}
    for cname, rel in raw_cmds.items():
        if not ID_RE.match(cname):
            errs.append(f"commands: invalid command name {cname!r}")
        problem = check_program(rel, mod_dir, release) if isinstance(rel, str) else "path must be a string"
        if problem:
            errs.append(f"commands.{cname}: {problem}")
        else:
            commands[cname] = os.path.join(mod_dir, rel)

    if not errs:
        entry.module = Module(entry.id, name, description, version, requires, after,
                              effects, platform, ops, commands, mod_dir)


def os_info():
    path = os.environ.get("SOFTSYNK_OS_RELEASE", "/etc/os-release")  # env: test hook
    info = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep:
                    info[k] = v.strip("\"'")
    except OSError:
        pass
    return info.get("ID", "").lower(), info.get("VERSION_ID", "")


def version_tuple(v):
    return tuple(int(x) for x in v.split(".")) if OS_VERSION_RE.match(v or "") else None


def platform_problem(mod):
    allowed = [x.lower() for x in mod.platform.get("os", [])]
    min_version = mod.platform.get("min_version", "")
    if not allowed and not min_version:
        return None
    os_id, os_version = os_info()
    if allowed and os_id not in allowed:
        return f"unsupported platform: needs {'/'.join(allowed)}, found {os_id or 'unknown'}"
    if min_version:
        have, need = version_tuple(os_version), version_tuple(min_version)
        if have is None or have < need:
            return f"unsupported platform: needs {os_id} >= {min_version}, found {os_version or 'unknown'}"
    return None


class Registry:
    """modules.toml plus validated manifests, in dependency order."""

    def __init__(self, release):
        self.release = os.path.realpath(release)
        self.entries = {}
        self._load()
        self._check_graph()
        self.order = self._order()

    def _load(self):
        path = os.path.join(self.release, "modules.toml")
        try:
            with open(path, "rb") as f:
                data = tomllib.load(f)
        except (OSError, tomllib.TOMLDecodeError) as e:
            raise Fail(f"cannot read registry {path}: {e}")
        if type(data.get("schema")) is not int or data["schema"] != SCHEMA:
            raise Fail(f"modules.toml: unsupported or missing schema {data.get('schema')!r} (expected {SCHEMA})")
        extra = set(data) - {"schema", "modules"}
        if extra:
            raise Fail(f"modules.toml: unknown field(s) {sorted(extra)}")
        modules = data.get("modules", [])
        if not isinstance(modules, list):
            raise Fail("modules.toml: 'modules' must be an array of [[modules]] tables")
        for item in modules:
            if (not isinstance(item, dict) or set(item) != {"id", "manifest"}
                    or not isinstance(item["id"], str) or not isinstance(item["manifest"], str)):
                raise Fail("modules.toml: each [[modules]] needs exactly 'id' and 'manifest' strings")
            if not ID_RE.match(item["id"]):
                raise Fail(f"modules.toml: invalid module id {item['id']!r} (pattern {ID_RE.pattern})")
            if item["id"] in self.entries:
                raise Fail(f"modules.toml: duplicate module id {item['id']!r}")
            entry = Entry(item["id"], item["manifest"])
            self.entries[entry.id] = entry
            parse_manifest(self.release, entry)
        for e in self.entries.values():
            if e.module:
                for r in e.module.requires:
                    if r not in self.entries:
                        e.errors.append(f"requires unknown module '{r}'")
                if e.errors:
                    e.module = None

    def _graph(self):
        valid = {i for i, e in self.entries.items() if e.module}
        return {i: [d for d in e.module.requires + e.module.after if d in valid]
                for i, e in self.entries.items() if e.module}

    def _check_graph(self):
        """Mark every module on a dependency cycle (requires or after) invalid."""
        graph = self._graph()
        state, path, cycles = {}, [], []

        def visit(n):
            if state.get(n) == 2:
                return
            if state.get(n) == 1:
                cycles.append(path[path.index(n):] + [n])
                return
            state[n] = 1
            path.append(n)
            for d in graph[n]:
                visit(d)
            path.pop()
            state[n] = 2

        for n in graph:
            visit(n)
        for cyc in cycles:
            text = "dependency cycle: " + " -> ".join(cyc)
            for n in set(cyc):
                e = self.entries[n]
                e.module = None
                if text not in e.errors:
                    e.errors.append(text)
        for e in self.entries.values():
            if e.module:
                e.unsupported = platform_problem(e.module)

    def _order(self):
        """Dependencies first; registry order breaks ties. Valid modules only."""
        graph, seen, order = self._graph(), set(), []

        def visit(n):
            if n in seen:
                return
            seen.add(n)
            for d in graph[n]:
                visit(d)
            order.append(n)

        for n in graph:
            visit(n)
        return order

    def unusable(self, mid, _depth=0):
        """Why a module cannot be installed/run (None if it can)."""
        e = self.entries[mid]
        if e.module is None:
            more = f" (+{len(e.errors) - 1} more)" if len(e.errors) > 1 else ""
            return f"invalid manifest: {e.errors[0]}{more}"
        if e.unsupported:
            return e.unsupported
        for r in e.module.requires:
            why = self.unusable(r)
            if why:
                return f"requires {r}, which is unusable ({why})"
        return None


# ---------------------------------------------------------------- context

@dataclasses.dataclass
class Ctx:
    root: str
    release: str
    version: str
    noninteractive: bool
    accept_defaults: bool
    dry_run: bool
    run_id: str
    status_timeout: float


def module_env(ctx, mod):
    env = dict(os.environ)
    env.pop("SOFTSYNK_LOCK_HELD", None)
    for key, sub in (("ETC", "etc"), ("SECRETS", "secrets"), ("STATE", "state"),
                     ("LOG", "log"), ("TMP", "tmp")):
        env[f"SOFTSYNK_{key}_DIR"] = os.path.join(ctx.root, sub, mod.id)
    env.update(
        SOFTSYNK_ROOT=ctx.root,
        SOFTSYNK_MODULE=mod.id,
        SOFTSYNK_INTERACTIVE="0" if ctx.noninteractive else "1",
        SOFTSYNK_NONINTERACTIVE="1" if ctx.noninteractive else "0",
        SOFTSYNK_ACCEPT_DEFAULTS="1" if ctx.accept_defaults else "0",
        SOFTSYNK_DRY_RUN="1" if ctx.dry_run else "0",
        SOFTSYNK_RUN_ID=ctx.run_id,
    )
    return env


# ---------------------------------------------------------------- status

def blank_record(entry, health="unknown", state="unknown", summary=""):
    m = entry.module
    return {"module": entry.id, "name": m.name if m else entry.id,
            "version": m.version if m else "", "observed_at": now_iso(),
            "install_state": state, "health": health, "summary": summary,
            "details": {}, "warnings": [], "actions": []}


def check_status_doc(doc, mid):
    """Return (normalized fields, None) or (None, problem)."""
    if not isinstance(doc, dict):
        return None, "status output is not a JSON object"
    schema = doc.get("schema")
    if type(schema) is not int or schema != SCHEMA:
        return None, f"unsupported status schema {schema!r} (expected {SCHEMA})"
    if doc.get("module") != mid:
        return None, f"status is for module {doc.get('module')!r}, expected {mid!r}"
    if doc.get("install_state") not in INSTALL_STATES:
        return None, f"invalid install_state {doc.get('install_state')!r}"
    if doc.get("health") not in HEALTHS:
        return None, f"invalid health {doc.get('health')!r}"
    out = {"install_state": doc["install_state"], "health": doc["health"]}
    for key, typ, default in (("summary", str, ""), ("version", str, None),
                              ("observed_at", str, None), ("details", dict, {}),
                              ("warnings", list, []), ("actions", list, [])):
        v = doc.get(key, default)
        if v is None:
            continue
        if not isinstance(v, typ):
            return None, f"'{key}' must be of type {typ.__name__}"
        out[key] = v
    if not all(isinstance(w, str) for w in out.get("warnings", [])):
        return None, "'warnings' must be an array of strings"
    return out, None


def run_status(ctx, entry):
    """Run a module's status op under a timeout. Always returns a record."""
    mod = entry.module
    rec = blank_record(entry)
    try:
        p = subprocess.Popen(mod.ops["status"], cwd=mod.dir, env=module_env(ctx, mod),
                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, start_new_session=True)
    except OSError as e:
        rec["summary"] = "status could not be started"
        rec["warnings"].append(f"cannot run status: {e.strerror}")
        return rec
    try:
        out, _ = p.communicate(timeout=ctx.status_timeout)
    except subprocess.TimeoutExpired:
        kill_group(p)
        rec["summary"] = "status timed out"
        rec["warnings"].append(f"status timed out after {ctx.status_timeout:g}s")
        return rec
    except BaseException:
        kill_group(p)
        raise
    try:
        doc = json.loads(out.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        doc = None
    fields, problem = check_status_doc(doc, mod.id) if doc is not None else (
        None, f"status output is not valid JSON (exit {p.returncode})")
    if problem:
        rec["summary"] = "status unreadable"
        rec["warnings"].append(problem)
        return rec
    rec.update(fields)
    return rec


def kill_group(p):
    with contextlib.suppress(ProcessLookupError, PermissionError):
        os.killpg(p.pid, signal.SIGKILL)
    with contextlib.suppress(subprocess.TimeoutExpired):
        p.communicate(timeout=5)


def collect_status(ctx, reg, ids=None):
    """Sequential status of every (or the given) module -> list of records."""
    records = []
    for mid, e in reg.entries.items():
        if ids is not None and mid not in ids:
            continue
        if e.module is None:
            rec = blank_record(e, summary="invalid manifest")
            rec["warnings"] = list(e.errors)
        elif e.unsupported:
            rec = blank_record(e, health="unsupported", summary=e.unsupported)
        else:
            rec = run_status(ctx, e)
        records.append(rec)
    return records


def exit_for(records):
    """Worst exit code over modules that count (installed/adopted/unknown)."""
    code = OK
    for r in records:
        if r["health"] == "unsupported" or r["install_state"] == "not_installed":
            continue
        c = HEALTH_EXIT[r["health"]]
        if SEVERITY[c] > SEVERITY[code]:
            code = c
    return code


def table(headers, rows):
    widths = [max(len(str(r[i])) for r in [headers] + rows) for i in range(len(headers))]
    return "\n".join("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip()
                     for r in [headers] + rows)


def cmd_status(ctx, reg, as_json):
    records = collect_status(ctx, reg)
    code = exit_for(records)
    if as_json:
        say(json.dumps({"schema": SCHEMA, "framework": {"version": ctx.version, "interface": INTERFACE},
                        "observed_at": now_iso(),
                        "overall": {"health": OVERALL_LABEL[code], "exit_code": code},
                        "modules": records}, indent=2, sort_keys=True))
        return code
    say(f"softsynk-server {ctx.version} (interface {INTERFACE}), root {ctx.root}")
    rows = [(r["module"], r["install_state"], r["health"], r["summary"]) for r in records]
    say(table(("MODULE", "INSTALL", "HEALTH", "SUMMARY"), rows) if rows else "no modules registered")
    for r in records:
        for w in r["warnings"]:
            say(f"  ! {r['module']}: {w}")
    ignored = sum(1 for r in records if r["install_state"] == "not_installed")
    if ignored:
        say(f"{ignored} module(s) not installed (not counted in health)")
    say(f"overall: {OVERALL_LABEL[code]} (exit {code})")
    return code


def cmd_list(ctx, reg):
    records = {r["module"]: r for r in collect_status(ctx, reg)}
    rows = []
    for mid, e in reg.entries.items():
        notes = []
        if e.module is None:
            notes.append(reg.unusable(mid))
        else:
            if e.unsupported:
                notes.append(e.unsupported)
            for r in e.module.requires:
                why = reg.unusable(r)
                if why:
                    notes.append(f"blocked: requires {r} ({why})")
                elif records[r]["install_state"] not in ("installed", "adopted"):
                    notes.append(f"requires {r} (not installed)")
        platform = "unsupported" if e.unsupported else ("invalid" if e.module is None else "ok")
        rows.append((mid, e.module.version if e.module else "-", records[mid]["install_state"],
                     platform, "; ".join(notes)))
    say(table(("MODULE", "VERSION", "INSTALL", "PLATFORM", "NOTES"), rows) if rows else "no modules registered")
    return OK


def cmd_validate(ctx, reg):
    bad = 0
    for mid, e in reg.entries.items():
        if e.module is None:
            bad += 1
            say(f"INVALID {mid} ({e.manifest})")
            for msg in e.errors:
                say(f"  - {msg}")
        else:
            say(f"ok      {mid} ({e.manifest})" + (f"  [{e.unsupported}]" if e.unsupported else ""))
    say(f"{len(reg.entries) - bad} valid, {bad} invalid")
    return FAILED if bad else OK


