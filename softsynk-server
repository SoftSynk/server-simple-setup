def gum_cmd():
    return shutil.which("gum")


def _gum(args, capture=True):
    p = subprocess.run([gum_cmd()] + args, stdout=subprocess.PIPE if capture else None, text=True)
    return p.returncode, p.stdout or ""


def ui_choose(header, options, many=False):
    """Return the chosen option(s). Raises Cancelled on Ctrl-C/Esc."""
    if gum_cmd():
        rc, out = _gum(["choose", "--header", header] + (["--no-limit"] if many else []) + list(options))
        if rc != 0:
            raise Cancelled()
        return [x for x in out.splitlines() if x]
    while True:
        say(header)
        for i, o in enumerate(options, 1):
            say(f"  {i}) {o}")
        try:
            raw = input("number" + ("s (blank = none)" if many else "") + ": ").replace(",", " ").split()
        except EOFError:
            raise Cancelled()
        if all(x.isdigit() and 1 <= int(x) <= len(options) for x in raw) and (raw or many) and (many or len(raw) == 1):
            return [options[int(x) - 1] for x in raw]
        say("invalid choice")


def ui_confirm(question):
    """Yes (default) / No. Raises Cancelled on Ctrl-C/Esc/EOF."""
    if gum_cmd():
        rc, _ = _gum(["confirm", question], capture=False)
        if rc == 0:
            return True
        if rc == 1:
            return False
        raise Cancelled()
    try:
        return input(f"{question} [Y/n] ").strip().lower() not in ("n", "no")
    except EOFError:
        raise Cancelled()


def ui_input(header):
    if gum_cmd():
        rc, out = _gum(["input", "--header", header])
        if rc != 0:
            raise Cancelled()
        return out.strip()
    try:
        return input(f"{header} ").strip()
    except EOFError:
        raise Cancelled()


def confirm(ctx, question):
    """Interactive confirm; non-interactive proceeds only with --accept-defaults."""
    if ctx.noninteractive:
        if ctx.accept_defaults:
            return True
        raise Fail(f"confirmation required for '{question}'; re-run with --accept-defaults", USAGE)
    return ui_confirm(question)


# ---------------------------------------------------------------- install / configure

def run_tty(ctx, mod, op):
    """Run a mutating op with the terminal attached. Returns the exit code."""
    previous = signal.signal(signal.SIGINT, lambda *_: None)  # Ctrl-C goes to the child; handlers reset on exec
    try:
        try:
            return subprocess.call(mod.ops[op], cwd=mod.dir, env=module_env(ctx, mod))
        except OSError as e:
            warn(f"cannot run {mod.id} {op}: {e.strerror}")
            return FAILED
    finally:
        signal.signal(signal.SIGINT, previous)


def classify(rc):
    if rc == 0:
        return "ok"
    if rc in (CANCELLED, -signal.SIGINT):
        return "cancelled"
    return "failed"


def installed(status, mid):
    return mid in status and status[mid]["install_state"] in ("installed", "adopted")


def static_blocks(reg, ordered, selected, status):
    """Blocked reasons known before running anything: id -> reason."""
    blocked = {}
    for mid in ordered:
        why = reg.unusable(mid)
        if not why:
            for r in reg.entries[mid].module.requires:
                if r in selected:
                    if r in blocked:
                        why = f"requires {r}, which is blocked"
                        break
                elif not installed(status, r):
                    why = f"requires {r}, which is not installed and was not selected"
                    break
        if why:
            blocked[mid] = why
    return blocked


def pick_interactive(ctx, reg, status):
    selected = []
    for mid in reg.order:
        e = reg.entries[mid]
        m, st = e.module, status[mid]
        if e.unsupported:
            continue
        if st["install_state"] in ("installed", "adopted"):
            say(f"\n{m.name} ({mid}): already {st['install_state']}; skipped (name it to re-run: install {mid})")
            continue
        say(f"\n{m.name} ({mid}) v{m.version}\n  {m.description}\n  state: {st['install_state']}")
        if m.effects:
            say("  effects: " + "; ".join(m.effects))
        if ui_confirm(f"Install {m.name}?"):
            selected.append(mid)
    return selected


def cmd_install(ctx, reg, names):
    unknown = [n for n in names if n not in reg.entries]
    if unknown:
        raise Fail(f"unknown module(s): {', '.join(unknown)} (see --list)", USAGE)
    if not names and ctx.noninteractive:
        raise Fail("install needs module names when non-interactive (e.g. 'install backup'; see --list)", USAGE)
    names = list(dict.fromkeys(names))
    with framework_lock(ctx.root):
        valid = [i for i in reg.entries if reg.entries[i].module and not reg.entries[i].unsupported]
        if not names:
            status = {r["module"]: r for r in collect_status(ctx, reg, set(valid))}
            names = pick_interactive(ctx, reg, status)
        else:
            need = {r for n in names if reg.entries[n].module for r in reg.entries[n].module.requires
                    if r not in names and r in valid}
            status = {r["module"]: r for r in collect_status(ctx, reg, need)}
        if not names:
            say("nothing selected")
            return OK
        selected = set(names)
        ordered = [i for i in reg.order if i in selected] + [i for i in names if i not in reg.order]
        blocked = static_blocks(reg, ordered, selected, status)

        say("\nPlan" + (" (dry run)" if ctx.dry_run else "") + ":")
        for n, mid in enumerate(ordered, 1):
            say(f"  {n}. {mid}: " + (f"BLOCKED, {blocked[mid]}" if mid in blocked else "install"))
        if len(blocked) < len(ordered) and not confirm(ctx, "Run this plan?"):
            say("aborted, nothing changed")
            return OK

        results = {}
        for mid in ordered:
            if mid in blocked:
                results[mid] = ("blocked", blocked[mid])
                continue
            mod = reg.entries[mid].module
            dead = [r for r in mod.requires if results.get(r, ("ok",))[0] != "ok"]
            if dead:
                results[mid] = ("blocked", f"requires {dead[0]}, which {results[dead[0]][0]}")
                continue
            say(f"\n==> installing {mid}")
            rc = run_tty(ctx, mod, "install")
            results[mid] = (classify(rc), f"exit {rc}")

        say("\nSummary:")
        for mid in ordered:
            state, detail = results[mid]
            say(f"  {mid}: {state}" + ("" if state == "ok" else f" ({detail})"))
        states = [s for s, _ in results.values()]
        code = (FAILED if "failed" in states else CANCELLED if "cancelled" in states
                else INCOMPLETE if "blocked" in states else OK)
        record_history(ctx, "install", {m: {"state": s, "detail": d} for m, (s, d) in results.items()}, code)
        return code


def cmd_configure(ctx, reg, names):
    if len(names) > 1:
        raise Fail("configure takes exactly one module", USAGE)
    if not names:
        if ctx.noninteractive:
            raise Fail("configure needs a module name when non-interactive (see --list)", USAGE)
        choices = [i for i, e in reg.entries.items() if e.module and "configure" in e.module.ops]
        if not choices:
            raise Fail("no module declares a configure operation", USAGE)
        names = ui_choose("Configure which module?", choices)
    mid = names[0]
    if mid not in reg.entries:
        raise Fail(f"unknown module: {mid} (see --list)", USAGE)
    why = reg.unusable(mid)
    if why:
        raise Fail(f"cannot configure {mid}: {why}", INCOMPLETE)
    mod = reg.entries[mid].module
    if "configure" not in mod.ops:
        raise Fail(f"module {mid} does not declare a configure operation", USAGE)
    with framework_lock(ctx.root):
        say(f"==> configuring {mid}")
        rc = run_tty(ctx, mod, "configure")
        state = classify(rc)
        code = OK if state == "ok" else CANCELLED if state == "cancelled" else FAILED
        record_history(ctx, "configure", {mid: {"state": state, "detail": f"exit {rc}"}}, code)
        return code


# ---------------------------------------------------------------- update / rollback

def cmd_update(ctx, src, sha):
    if not src:
        if ctx.noninteractive:
            raise Fail("update needs --from DIR|TARBALL (and --sha256 for a tarball)", USAGE)
        src = ui_input("Update source (directory or tarball path):")
    src = os.path.abspath(os.path.expanduser(src))
    if not os.path.exists(src):
        raise Fail(f"update source not found: {src}", USAGE)
    is_tar = os.path.isfile(src)
    if is_tar and not sha:
        if ctx.noninteractive:
            raise Fail("--sha256 is required for a tarball source", USAGE)
        sha = ui_input("Expected sha256 of the tarball:")
    if sha and not is_tar:
        raise Fail("--sha256 applies to tarball sources only", USAGE)
    if sha and not SHA_RE.match(sha):
        raise Fail("--sha256 must be 64 hex characters", USAGE)
    bootstrap = os.path.join(ctx.release, "bootstrap.sh")
    if not os.access(bootstrap, os.X_OK):
        raise Fail(f"bootstrap.sh not found or not executable in {ctx.release}")
    if not confirm(ctx, f"Update softsynk-server from {src}?"):
        say("aborted, nothing changed")
        return OK
    with framework_lock(ctx.root):
        cmd = [bootstrap, "--root", ctx.root, "--from", src] + (["--sha256", sha] if sha else [])
        env = dict(os.environ, SOFTSYNK_LOCK_HELD="1")  # bootstrap must not re-take our lock
        rc = subprocess.call(cmd, env=env)
        code = OK if rc == 0 else FAILED
        record_history(ctx, "update", {"framework": {"state": "ok" if rc == 0 else "failed", "detail": f"exit {rc}"}},
                       code, source=src)
        if rc != 0:
            warn("update failed; the current release was not changed")
        return code


def release_link(root, name):
    try:
        return os.readlink(os.path.join(root, name))
    except OSError:
        return None


def cmd_rollback(ctx):
    if not os.path.isdir(ctx.root):
        raise Fail(f"no installed release found under {ctx.root} (run bootstrap.sh first)")
    with framework_lock(ctx.root):
        cur, prev = release_link(ctx.root, "current"), release_link(ctx.root, "previous")
        if not cur:
            raise Fail(f"no installed release found under {ctx.root} (run bootstrap.sh first)")
        if not prev:
            raise Fail("no previous release recorded; nothing to roll back to")
        releases = os.path.realpath(os.path.join(ctx.root, "releases"))
        real = os.path.realpath(os.path.join(ctx.root, prev))
        if os.path.dirname(real) != releases or not os.path.isdir(real):
            raise Fail(f"previous release is missing or outside {releases}: {prev}")
        if not confirm(ctx, f"Roll back {cur} -> {prev}?"):
            say("aborted, nothing changed")
            return OK
        set_link(ctx.root, "current", prev)  # the switch itself first; then remember where we came from
        set_link(ctx.root, "previous", cur)
        say(f"rolled back: current -> {prev} (was {cur}); run --rollback again to return")
        say("note: only code is reverted, not system changes modules made (config, packages, units)")
        record_history(ctx, "rollback", {"framework": {"state": "ok", "detail": f"{cur} -> {prev}"}}, OK)
        return OK


# ---------------------------------------------------------------- menu / main

def cmd_menu(ctx, reg):
    items = {"Status": lambda: cmd_status(ctx, reg, False),
             "List modules": lambda: cmd_list(ctx, reg),
             "Install modules": lambda: cmd_install(ctx, reg, []),
             "Configure a module": lambda: cmd_configure(ctx, reg, []),
             "Update from directory or tarball": lambda: cmd_update(ctx, None, None),
             "Roll back to previous release": lambda: cmd_rollback(ctx),
             "Quit": None}
    while True:
        choice = ui_choose(f"softsynk-server {ctx.version}", list(items))[0]
        if items[choice] is None:
            return OK
        try:
            items[choice]()
        except Fail as f:
            warn(f"error: {f}")
        except Cancelled:
            warn("cancelled")


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        warn(f"error: {message}")
        sys.exit(USAGE)


EPILOG = """\
commands:
  install [module...]     install modules in dependency order (interactive menu when none named)
  configure <module>      run a module's configure operation
  update                  stage, verify and activate a new release (--from DIR|TARBALL [--sha256 HEX])
  validate                check registry and manifests of this release (read-only)

exit codes: 0 ok/healthy, 1 degraded, 2 unhealthy or failed, 3 incomplete/blocked,
            64 invalid request or missing input, 130 cancelled
"""


def build_parser():
    p = Parser(prog="softsynk-server", description="Install, configure, update and check server modules.",
               epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", nargs="?", choices=COMMANDS, metavar="command")
    p.add_argument("modules", nargs="*", metavar="module")
    p.add_argument("--status", action="store_true", help="show module health (read-only)")
    p.add_argument("--json", action="store_true", help="with --status: machine-readable output")
    p.add_argument("--list", action="store_true", help="list modules with state and blockers (read-only)")
    p.add_argument("--rollback", action="store_true", help="switch back to the previous release")
    p.add_argument("--version", action="store_true", help="print version")
    p.add_argument("--root", help=f"management root (default: $SOFTSYNK_ROOT or {DEFAULT_ROOT})")
    p.add_argument("--from", dest="src", help="update source: directory or tarball")
    p.add_argument("--sha256", help="expected sha256 of a tarball source")
    p.add_argument("--non-interactive", action="store_true", help="never prompt (also: SOFTSYNK_NONINTERACTIVE=1)")
    p.add_argument("--accept-defaults", action="store_true", help="non-interactive: confirm prompts with their default")
    p.add_argument("--dry-run", action="store_true", help="install/configure: pass SOFTSYNK_DRY_RUN=1 to modules")
    return p


def check_args(a):
    actions = [x for x in (a.command, a.status and "--status", a.list and "--list",
                           a.rollback and "--rollback", a.version and "--version") if x]
    if len(actions) > 1:
        raise Fail(f"choose one action, got: {', '.join(actions)}", USAGE)
    if a.json and not a.status:
        raise Fail("--json is only valid with --status", USAGE)
    if (a.src or a.sha256) and a.command != "update":
        raise Fail("--from/--sha256 are only valid with update", USAGE)
    if a.modules and a.command not in ("install", "configure"):
        raise Fail("module names are only valid with install/configure", USAGE)
    if a.dry_run and a.command not in ("install", "configure"):
        raise Fail("--dry-run is only valid with install/configure", USAGE)


def main(argv=None):
    parser = build_parser()
    a = parser.parse_args(argv)
    try:
        check_args(a)
        release = release_dir()
        root = os.path.abspath(a.root or os.environ.get("SOFTSYNK_ROOT") or DEFAULT_ROOT)
        interactive = (sys.stdin.isatty() and sys.stdout.isatty() and not a.non_interactive
                       and os.environ.get("SOFTSYNK_NONINTERACTIVE") != "1")
        try:
            timeout = float(os.environ.get("SOFTSYNK_STATUS_TIMEOUT", "20"))
            if timeout <= 0:
                raise ValueError
        except ValueError:
            raise Fail("SOFTSYNK_STATUS_TIMEOUT must be a positive number", USAGE)
        ctx = Ctx(root, release, read_version(release), not interactive,
                  a.accept_defaults or os.environ.get("SOFTSYNK_ACCEPT_DEFAULTS") == "1",
                  a.dry_run, datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
                  + "-" + uuid.uuid4().hex[:6], timeout)
        if a.version:
            say(f"softsynk-server {ctx.version} (module interface {INTERFACE})")
            return OK
        if a.rollback:
            return cmd_rollback(ctx)
        if a.command == "update":
            return cmd_update(ctx, a.src, a.sha256)
        reg = Registry(release)
        if a.status:
            return cmd_status(ctx, reg, a.json)
        if a.list:
            return cmd_list(ctx, reg)
        if a.command == "validate":
            return cmd_validate(ctx, reg)
        if a.command == "install":
            return cmd_install(ctx, reg, a.modules)
        if a.command == "configure":
            return cmd_configure(ctx, reg, a.modules)
        if ctx.noninteractive:
            parser.print_help(sys.stderr)
            raise Fail("no command given and no terminal for the menu", USAGE)
        return cmd_menu(ctx, reg)
    except Fail as f:
        warn(f"error: {f}")
        return f.code
    except (KeyboardInterrupt, Cancelled):
        warn("cancelled")
        return CANCELLED


if __name__ == "__main__":
    sys.exit(main())
